# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role só no servidor — NUNCA expor pro client.
# Consumida pelo convite de membros (Fase 4): cria a conta do convidado via
# admin API. Sem ela, convidar e-mail novo falha com erro claro na tela.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Resend (e-mail transacional enviado pelo próprio app)
# ============================================================
# A MESMA API key usada no SMTP do Supabase serve aqui. Primeiro consumidor:
# o aviso de convite para e-mail que JÁ tem conta (o Supabase se recusa a
# enviar para usuário existente, então o app envia por conta própria).
# Sem ela, o convite ainda funciona — mas a pessoa não é avisada.
RESEND_API_KEY=
# Opcional: sobrepõe o remetente padrão (lure.expert <ti@lureconsultoria.com.br>).
# Precisa ser um endereço do domínio verificado no Resend.
EMAIL_REMETENTE=

# Conexão direta com o Postgres (Drizzle migrate / db:push)
# Pegue em Supabase Dashboard > Settings > Database > Connection string > URI
DATABASE_URL=

# ============================================================
# Anthropic (Claude Haiku 4.5 + Sonnet 4.6)
# ============================================================
ANTHROPIC_API_KEY=

# ============================================================
# Inngest (jobs em background)
# ============================================================
# Em dev local, basta INNGEST_DEV=1 — o resto é opcional e usado em produção.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ============================================================
# Pluggy (Open Finance — Fase 4)
# ============================================================
# Crie sua conta em https://dashboard.pluggy.ai e gere as credenciais de API.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# 'sandbox' enquanto desenvolve, 'production' depois de homologar.
PLUGGY_ENVIRONMENT=sandbox
# Segredo HMAC opcional para validar webhooks de item/update do Pluggy.
PLUGGY_WEBHOOK_SECRET=

# Chave-mestra que cifra as chaves de IA das organizacoes (AES-256-GCM).
# 32 bytes em hex. OBRIGATORIA a partir da Fase 2 -- sem ela, nenhuma
# organizacao consegue cadastrar nem usar chave propria.
# Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENCAO: trocar esta chave torna ilegiveis todas as chaves ja cadastradas.
ENCRYPTION_KEY=

# A chave da Lure. A partir da Fase 2 ela atende SOMENTE as organizacoes
# marcadas como key_source = 'platform' -- as de teste e o trial, se houver.
# Deixar vazia desliga a IA para essas organizacoes, sem afetar quem tem
# chave propria.
